# 複製成 .env 後填入真實值，再執行 `docker compose up`。
# .env 內含機密，切勿提交進版本控制。

# PostgreSQL 帳號密碼（請使用強隨機密碼）
POSTGRES_USER=vbtt
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# JWT 簽章金鑰：至少 32 字元的隨機字串。
# 產生方式：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_至少32字元的隨機字串_請用_openssl_rand_產生

# 超級管理員 YUANHE 的初始密碼（至少 8 字元，首次登入後請立即更換）
ADMIN_PASSWORD=CHANGE_ME_admin_password

# 對外正式網址（供 CORS 白名單使用），例如 https://vbtt.example.com
PUBLIC_ORIGIN=http://localhost:8080
