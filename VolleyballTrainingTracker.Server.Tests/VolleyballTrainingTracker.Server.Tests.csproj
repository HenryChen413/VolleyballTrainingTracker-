<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 測試只需後端組件，不要連帶建置前端 SPA（見 Server.csproj 的 BuildClient 說明） -->
    <BuildClient>false</BuildClient>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 測試會用到 ASP.NET Core 型別（AuthorizationFilterContext 等），需明確引用框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VolleyballTrainingTracker.Server\VolleyballTrainingTracker.Server.csproj">
      <!-- 以全域屬性傳入，確保被參考的 Server 專案也跳過前端建置 -->
      <AdditionalProperties>BuildClient=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
